# walk, the bankroll_sim price cache, and the in-game win-probability
# history) -- several MB of derived data that
# has no business in the history.
data/nfl_games_cache.csv
data/nba_games_cache/
data/nhl_games_cache/
data/elo_mlb_history_cache.json
backtest/elo_mlb_cache.json
backtest/bankroll_sim_cache.json
